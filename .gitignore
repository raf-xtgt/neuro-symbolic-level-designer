# ── Dart & Flutter ────────────────────────────────────────────────────────────
**/.dart_tool/
**/build/
**/.packages
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/doc/api/

# Compiled Web Output
**/*.dart.js
**/*.js
**/*.js_
**/*.js.deps
**/*.js.map
**/*.info.json

# ── Serverpod & Database ──────────────────────────────────────────────────────
# Passwords and sensitive server configurations
**/config/passwords.yaml
**/config/*_passwords.yaml

# Embedded / local database runtime data
**/data/
**/*.db
**/*.sqlite

# ── Python (Bob Skills & Tools) ───────────────────────────────────────────────
**/__pycache__/
**/*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env*
*.local
*.pem
*.key

# ── Operating System & Editors ────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
*~
*.swp
*.swo

# IDE settings (allow repo-level settings if explicitly needed)
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.sublime-workspace
*.sublime-project

# ── Logs & Scratch ────────────────────────────────────────────────────────────
*.log
**/logs/
**/scratch/
**/tmp/
